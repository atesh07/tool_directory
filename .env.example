# Optional. Leave empty on Vercel: the site URL is detected automatically. Set it once you connect your own domain, e.g. https://example.com
NEXT_PUBLIC_SITE_URL=

# Optional. Email shown on the Contact, Privacy and Terms pages.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional: Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Optional: verification codes from Google Search Console and Bing Webmaster Tools
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=
